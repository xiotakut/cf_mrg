{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnifiedCounterfactualMedicalQAItem",
  "type": "object",
  "required": [
    "item_id",
    "dataset",
    "task_family",
    "variant",
    "question",
    "answer",
    "metadata"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "string",
      "enum": [
        "medpic",
        "clir",
        "medeinst",
        "medcounterfact",
        "remedqa",
        "cpv",
        "medequalqa",
        "fairmedqa",
        "cladder",
        "cpenv"
      ]
    },
    "task_family": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "answer": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patient_state": {
      "type": "object"
    },
    "time_series": {
      "type": "array"
    },
    "fixed_evidence": {
      "type": "array"
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "should_answer_change": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "change_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
